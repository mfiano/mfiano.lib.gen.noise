(define-ftype curve3 (f32) f32)
(declaim (inline curve3))
(defun curve3 (x)
  (* x x (- 3f0 (* x 2f0))))

(define-ftype curve5 (f32) f32)
(declaim (inline curve5))
(defun curve5 (x)
  (* x x x (+ (* x (- (* x 6f0) 15f0)) 10f0)))

(define-ftype cubic-interpolate (f32 f32 f32 f32 f32) f32)
(declaim (inline cubic-interpolate))
(defun cubic-interpolate (a b c d alpha)
  (let* ((a-b (- a b))
         (x (- (- d c) a-b))
         (y (- a-b x))
         (z (- c a))
         (alpha^2 (* alpha alpha)))
    (+ (* x alpha^2 alpha) (* y alpha^2) (* z alpha) b)))
