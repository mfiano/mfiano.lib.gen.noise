(in-package #:mfiano.lib.gen.noise)

(define-constant +opensimplex2-2d/skew+ 0.366025403784439d0 :test #'=)
(define-constant +opensimplex2-2d/unskew+ -0.21132486540518713d0 :test #'=)

(deftype opensimplex2-2d/orientation () '(member nil :x))

(defstruct (opensimplex2-2d
            (:include sampler-2d)
            (:constructor %make-opensimplex2-2d)
            (:predicate nil)
            (:copier nil))
  (table (make-f64-array 512) :type (f64-array 512))
  (orientation nil :type opensimplex2-2d/orientation))

(defmethod (setf seed) :after (value (sampler opensimplex2-2d))
  (setf (opensimplex2-2d-table sampler) (make-lookup-table/opensimplex2 sampler)))

(defun make-opensimplex2-2d (&key (seed 0) orient)
  (check-type seed u64)
  (check-type orient opensimplex2-2d/orientation)
  (let ((sampler (%make-opensimplex2-2d :orientation orient)))
    (setf (seed sampler) seed)
    sampler))

(defmethod opensimplex2/gradient-scale ((sampler opensimplex2-2d))
  0.010016340762376785d0)

(declaim (inline opensimplex2-2d/grad))
(defun opensimplex2-2d/grad (table seed x1 y1 x2 y2)
  (let* ((hash (u64* (logxor seed x1 y1) +hash-multiplier+))
         (i (logand (truncate (logxor hash (shr hash 58))) (shl 255 1)))
         (t1 (aref table i))
         (t2 (aref table (logior i 1))))
    (+ (* t1 x2) (* t2 y2))))

(declaim (inline opensimplex2-2d/orient))
(defun opensimplex2-2d/orient (orientation x y)
  (ecase orientation
    ((nil)
     (let ((s (* +opensimplex2-2d/skew+ (+ x y))))
       (values (+ x s) (+ y s))))
    (:x
     (let* ((s #.(* (1+ (* +opensimplex2-2d/skew+ 2)) +root2/2+))
            (xx (* x +root2/2+))
            (yy (* y s)))
       (values (+ yy xx)
               (- yy xx))))))

(define-ftype sample-opensimplex2-2d (opensimplex2-2d fixnum f32 fixnum f32) f32)
(declaim (inline sample-opensimplex2-2d))
(defun sample-opensimplex2-2d (sampler xi xf yi yf)
  (declare (optimize (speed 3)))
  (flet ((acc (x y)
           (- 0.5d0 (* x x) (* y y))))
    (declare (inline acc))
    (let ((table (opensimplex2-2d-table sampler))
          (seed (%seed sampler))
          (orientation (opensimplex2-2d-orientation sampler))
          (x (+ xi (f64 xf)))
          (y (+ yi (f64 yf))))
      (multiple-value-bind (trx try) (opensimplex2-2d/orient orientation x y)
        (let* ((x1 (floor trx))
               (y1 (floor try))
               (vtrx (- trx x1))
               (vtry (- try y1))
               (u (* (+ vtrx vtry) +opensimplex2-2d/unskew+))
               (x2 (u64* x1 +prime-x+))
               (y2 (u64* y1 +prime-y+))
               (x3 (u64+ x2 +prime-x+))
               (y3 (u64+ y2 +prime-y+))
               (x4 (+ vtrx u))
               (y4 (+ vtry u))
               (us #.(1+ (* +opensimplex2-2d/unskew+ 2)))
               (a (acc x4 y4))
               (r 0d0))
          (declare (type i64 x1 y1))
          (when (plusp a)
            (incf r (* a a a a (opensimplex2-2d/grad table seed x2 y2 x4 y4))))
          (let ((a (+ (* us 2 #.(+ (/ +opensimplex2-2d/unskew+) 2) u) (* us us -2) a)))
            (when (plusp a)
              (incf r (* a a a a (opensimplex2-2d/grad table seed x3 y3 (- x4 us) (- y4 us))))))
          (if (> y4 x4)
              (let* ((x (- x4 +opensimplex2-2d/unskew+))
                     (y (- y4 #.(1+ +opensimplex2-2d/unskew+)))
                     (a (acc x y)))
                (when (plusp a)
                  (incf r (* a a a a (opensimplex2-2d/grad table seed x2 y3 x y)))))
              (let* ((x (- x4 #.(1+ +opensimplex2-2d/unskew+)))
                     (y (- y4 +opensimplex2-2d/unskew+))
                     (a (acc x y)))
                (when (plusp a)
                  (incf r (* a a a a (opensimplex2-2d/grad table seed x3 y2 x y))))))
          (f32 r))))))

(defmethod sample-function ((sampler opensimplex2-2d))
  #'sample-opensimplex2-2d)
