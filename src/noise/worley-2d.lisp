(in-package #:mfiano.lib.gen.noise)

(define-constant +worley-2d/jitter+ 0.43701595 :test #'=)

(defstruct (worley-2d
            (:include sampler-2d)
            (:constructor %make-worley-2d)
            (:predicate nil)
            (:copier nil))
  (table (make-f64-array 512) :type (f64-array 512))
  (jitter 1d0 :type f64)
  (output :f1 :type worley-output)
  (metric :euclidean :type worley-metric))

(defmethod (setf seed) :after (value (sampler worley-2d))
  (setf (worley-2d-table sampler) (make-lookup-table/worley sampler)))

(defun make-worley-2d (&key (seed 0) (jitter 1) (output :f1) (metric :euclidean))
  (check-type seed u64)
  (check-type jitter real)
  (check-type output worley-output)
  (check-type metric worley-metric)
  (let ((sampler (%make-worley-2d :jitter (f64 jitter) :output output :metric metric)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-worley-2d (worley-2d fixnum f32 fixnum f32) f32)
(declaim (inline sample-worley-2d))
(defun sample-worley-2d (sampler xi xf yi yf)
  (declare (optimize (speed 3)))
  (flet ((distance (metric x y)
           (ecase metric
             (:manhattan (+ (abs x) (abs y)))
             (:euclidean (sqrt (+ (* x x) (* y y))))
             (:euclidean-squared (+ (* x x) (* y y)))
             (:chebyshev (max (abs x) (abs y)))
             (:minkowski4 (expt (the (f64 0d0) (+ (* x x x x) (* y y y y))) 0.25d0)))))
    (declare (inline distance))
    (let* ((table (worley-2d-table sampler))
           (seed (%seed sampler))
           (jitter1 (worley-2d-jitter sampler))
           (jitter2 (* jitter1 +worley-2d/jitter+))
           (output (worley-2d-output sampler))
           (metric (worley-2d-metric sampler))
           (x (+ xi (f64 xf)))
           (y (+ yi (f64 yf)))
           (xr (1- xi))
           (yr (1- yi))
           (xp (u64* xr +prime-x+))
           (yp-base (u64* yr +prime-y+))
           (min max/f64+)
           (max max/f64+)
           (closest-hash 0))
      (dotimes (xi 3)
        (let ((xri (- (+ xr xi) x))
              (yp yp-base))
          (dotimes (yi 3)
            (let* ((yri (- (+ yr yi) y))
                   (hash (u64* (logxor seed xp yp) +hash1+))
                   (i (logand hash #.(shl 255 1)))
                   (j (logior i 1))
                   (vx (+ (* (aref table i) jitter2) xri))
                   (vy (+ (* (aref table j) jitter2) yri))
                   (distance (distance metric vx vy)))
              (setf max (s64:clamp distance min max))
              (when (< distance min)
                (setf min distance
                      closest-hash hash))
              (u64-incf yp +prime-y+)))
          (u64-incf xp +prime-x+)))
      (f32 (1- (worley-output output metric closest-hash min max))))))

(defmethod sample-function ((sampler worley-2d))
  #'sample-worley-2d)
