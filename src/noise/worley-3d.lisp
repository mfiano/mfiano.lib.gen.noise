(in-package #:mfiano.lib.gen.noise)

(define-constant +worley-3d/jitter+ 0.39614353 :test #'=)

(defstruct (worley-3d
            (:include sampler-3d)
            (:constructor %make-worley-3d)
            (:predicate nil)
            (:copier nil))
  (table (make-f64-array 1024) :type (f64-array 1024))
  (jitter 1d0 :type f64)
  (output :f1 :type worley-output)
  (metric :euclidean :type worley-metric))

(defmethod (setf seed) :after (value (sampler worley-3d))
  (setf (worley-3d-table sampler) (make-lookup-table/worley sampler)))

(defun make-worley-3d (&key (seed 0) (jitter 1) (output :f1) (metric :euclidean))
  (check-type seed u64)
  (check-type jitter real)
  (check-type output worley-output)
  (check-type metric worley-metric)
  (let ((sampler (%make-worley-3d :jitter (f64 jitter) :output output :metric metric)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-worley-3d (worley-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-worley-3d))
(defun sample-worley-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (flet ((distance (metric x y z)
           (ecase metric
             (:manhattan (+ (abs x) (abs y) (abs z)))
             ((:euclidean :euclidean-squared) (+ (* x x) (* y y) (* z z)))
             (:chebyshev (max (abs x) (abs y) (abs z)))
             (:minkowski4
              (let ((x (* x x x x))
                    (y (* y y y y))
                    (z (* z z z z)))
                (expt (the (f64 0d0) (+ x y z)) 0.25d0))))))
    (declare (inline distance))
    (let* ((table (worley-3d-table sampler))
           (seed (%seed sampler))
           (jitter1 (worley-3d-jitter sampler))
           (jitter2 (* jitter1 +worley-3d/jitter+))
           (output (worley-3d-output sampler))
           (metric (worley-3d-metric sampler))
           (x (+ xi (f64 xf)))
           (y (+ yi (f64 yf)))
           (z (+ zi (f64 zf)))
           (xr (1- xi))
           (yr (1- yi))
           (zr (1- zi))
           (xp (u64* xr +prime-x+))
           (yp-base (u64* yr +prime-y+))
           (zp-base (u64* zr +prime-z+))
           (min max/f64+)
           (max max/f64+)
           (closest-hash 0))
      (dotimes (xi 3)
        (let ((xri (- (+ xr xi) x))
              (yp yp-base))
          (dotimes (yi 3)
            (let ((yri (- (+ yr yi) y))
                  (zp zp-base))
              (dotimes (zi 3)
                (let* ((zri (- (+ zr zi) z))
                       (hash (u64* (logxor seed xp yp zp) +hash1+))
                       (i (logand hash #.(shl 255 2)))
                       (j (logior i 1))
                       (k (logior i 2))
                       (vx (+ (* (aref table i) jitter2) xri))
                       (vy (+ (* (aref table j) jitter2) yri))
                       (vz (+ (* (aref table k) jitter2) zri))
                       (distance (distance metric vx vy vz)))
                  (setf max (s64:clamp distance min max))
                  (when (< distance min)
                    (setf min distance
                          closest-hash hash))
                  (u64-incf zp +prime-z+)))
              (u64-incf yp +prime-y+)))
          (u64-incf xp +prime-x+)))
      (f32 (1- (worley-output output metric closest-hash min max))))))

(defmethod sample-function ((sampler worley-3d))
  #'sample-worley-3d)
