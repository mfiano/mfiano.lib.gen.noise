(defgeneric opensimplex2/gradients (sampler)
  (:method ((sampler sampler-2d))
    +opensimplex2-2d/gradients+)
  (:method ((sampler sampler-3d))
    +opensimplex2-3d/gradients+))

(defgeneric opensimplex2/gradient-scale (sampler))

(defun make-lookup-table/opensimplex2 (sampler)
  (let* ((table (make-f64-array (* (expt 2 (1- (dimensions sampler))) 256)))
         (gradients (opensimplex2/gradients sampler))
         (gradients-length (length gradients))
         (scale (opensimplex2/gradient-scale sampler)))
    (dotimes (i gradients-length)
      (setf (aref table i) (/ (aref gradients i) scale)))
    (dotimes (i (ceiling (length table) gradients-length))
      (replace table table :start1 (* gradients-length i)))
    table))
