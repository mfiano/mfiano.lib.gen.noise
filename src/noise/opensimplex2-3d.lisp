(in-package #:mfiano.lib.gen.noise)

(define-constant +opensimplex2-3d/seed-flip+ #x-52d547b2e96ed629 :test #'=)
(define-constant +opensimplex2-3d/normalize+ 2.6142766776628386d0 :test #'=)

(deftype opensimplex2-3d/orientation () '(member nil :xy :xz))

(defstruct (opensimplex2-3d
            (:include sampler-3d)
            (:constructor %make-opensimplex2-3d)
            (:predicate nil)
            (:copier nil))
  (table (make-f64-array 1024) :type (f64-array 1024))
  (orientation nil :type opensimplex2-3d/orientation))

(defmethod (setf seed) :after (value (sampler opensimplex2-3d))
  (setf (opensimplex2-3d-table sampler) (make-lookup-table/opensimplex2 sampler)))

(defun make-opensimplex2-3d (&key (seed 0) orient)
  (check-type seed u64)
  (check-type orient opensimplex2-3d/orientation)
  (let ((sampler (%make-opensimplex2-3d :orientation orient)))
    (setf (seed sampler) seed)
    sampler))

(defmethod opensimplex2/gradient-scale ((sampler opensimplex2-3d))
  0.07969837668935331d0)

(declaim (inline opensimplex2-3d/grad))
(defun opensimplex2-3d/grad (table seed x1 y1 z1 x2 y2 z2)
  (let* ((hash (logxor #1=(u64* (logxor (logxor seed x1) (logxor y1 z1)) +hash-multiplier+)
                       (shr #1# 58)))
         (i (logand (truncate hash) 1020))
         (t1 (aref table i))
         (t2 (aref table (logior i 1)))
         (t3 (aref table (logior i 2))))
    (+ (* t1 x2) (* t2 y2) (* t3 z2))))

(declaim (inline opensimplex2-3d/orient))
(defun opensimplex2-3d/orient (orientation x y z)
  (flet ((%orient (x y z)
           (let* ((xy (+ x y))
                  (zz (* z +root3/3+))
                  (xyr (* xy +opensimplex2-2d/unskew+)))
             (values (+ x xyr zz)
                     (+ y xyr zz)
                     (+ (* xy #.(- +root3/3+)) zz)))))
    (declare (inline %orient))
    (ecase orientation
      ((nil)
       (let ((s (* #.(/ 2d0 3d0) (+ x y z))))
         (values (- s x) (- s y) (- s z))))
      (:xy
       (%orient x y z))
      (:xz
       (%orient x z y)))))

(define-ftype sample-opensimplex2-3d (opensimplex2-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-opensimplex2-3d))
(defun sample-opensimplex2-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (labels ((%c (table seed a x y z x1 y1 z1)
             (if (> a 1)
                 (let ((a (1- a)))
                   (* a a a a (opensimplex2-3d/grad table seed x y z x1 y1 z1)))
                 0d0))
           (c1 (table seed a x y z x1 y1 z1 x2 y2 z2 xs ys zs)
             (let ((r 0d0))
               (when (plusp a)
                 (incf r (* a a a a (opensimplex2-3d/grad table seed x y z x1 y1 z1))))
               (cond
                 ((and (>= x2 y2) (>= x2 z2))
                  (let ((x (u64- x (u64* xs +prime-x+))))
                    (incf r (%c table seed (+ a (* x2 2)) x y z (+ x1 xs) y1 z1))))
                 ((and (>= y2 x2) (>= y2 z2))
                  (let ((y (u64- y (u64* ys +prime-y+))))
                    (incf r (%c table seed (+ a (* y2 2)) x y z x1 (+ y1 ys) z1))))
                 (t
                  (let ((z (u64- z (u64* zs +prime-z+))))
                    (incf r (%c table seed (+ a (* z2 2)) x y z x1 y1 (+ z1 zs))))))
               r))
           (c2 (table seed a x y z x1 y1 z1 x2 y2 z2 xs ys zs)
             (let ((seed (u64 (logxor seed +opensimplex2-3d/seed-flip+))))
               (c1 table seed a x y z x1 y1 z1 x2 y2 z2 (- xs) (- ys) (- zs)))))
    (declare (inline %c c1 c2))
    (let ((table (opensimplex2-3d-table sampler))
          (seed (%seed sampler))
          (orientation (opensimplex2-3d-orientation sampler))
          (x (+ xi (f64 xf)))
          (y (+ yi (f64 yf)))
          (z (+ zi (f64 zf))))
      (multiple-value-bind (trx try trz) (opensimplex2-3d/orient orientation x y z)
        (let* ((vx (round trx))
               (vy (round try))
               (vz (round trz))
               (x1 (u64* vx +prime-x+))
               (y1 (u64* vy +prime-y+))
               (z1 (u64* vz +prime-z+))
               (x2 (- trx vx))
               (y2 (- try vy))
               (z2 (- trz vz))
               (sx (logior (truncate (- -1 x2)) 1))
               (sy (logior (truncate (- -1 y2)) 1))
               (sz (logior (truncate (- -1 z2)) 1))
               (x3 (u64+ x1 (logand (shr sx 1) +prime-x+)))
               (y3 (u64+ y1 (logand (shr sy 1) +prime-y+)))
               (z3 (u64+ z1 (logand (shr sz 1) +prime-z+)))
               (x4 (* sx (- x2)))
               (y4 (* sy (- y2)))
               (z4 (* sz (- z2)))
               (x5 (- 0.5d0 x4))
               (y5 (- 0.5d0 y4))
               (z5 (- 0.5d0 z4))
               (x6 (* sx x5))
               (y6 (* sy y5))
               (z6 (* sz z5))
               (a1 (- 0.5d0 (* x2 x2) (+ (* y2 y2) (* z2 z2))))
               (a2 (- (+ a1 0.75d0) x5 (+ y5 z5)))
               (c1 (c1 table seed a1 x1 y1 z1 x2 y2 z2 x4 y4 z4 sx sy sz))
               (c2 (c2 table seed a2 x3 y3 z3 x6 y6 z6 x5 y5 z5 sx sy sz)))
          (declare (type (f64 #.(- #1=(expt 2d0 62)) #.#1#) x2 y2 z2))
          (declare (type i64 vx vy vz))
          (f32 (* (+ c1 c2) +opensimplex2-3d/normalize+)))))))

(defmethod sample-function ((sampler opensimplex2-3d))
  #'sample-opensimplex2-3d)
