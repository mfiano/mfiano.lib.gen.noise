(in-package #:mfiano.lib.gen.noise)

(define-constant +simplex-3d/skew+ #.(/ 3d0) :test #'=)
(define-constant +simplex-3d/unskew+ #.(/ 6d0) :test #'=)
(define-constant +simplex-3d/normalize+ 76.88123268100557d0 :test #'=)

(defstruct (simplex-3d
            (:include sampler-3d)
            (:constructor %make-simplex-3d)
            (:predicate nil)
            (:copier nil))
  (table (make-u8-array 512) :type (u8-array 512)))

(defmethod (setf seed) :after (value (sampler simplex-3d))
  (setf (simplex-3d-table sampler) (make-lookup-table/perlin sampler)))

(defun make-simplex-3d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-simplex-3d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-simplex-3d (simplex-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-simplex-3d))
(defun sample-simplex-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (flet ((grad (hash x y z)
           (let ((g (case (logand hash 15)
                      ((0 12) (- (+ x y)))
                      ((1 14) (- x y))
                      (2 (- y x))
                      (3 (+ x y))
                      (4 (- (+ x z)))
                      (5 (- x z))
                      (6 (- z x))
                      (7 (+ x z))
                      (8 (- (+ y z)))
                      ((9 13) (- y z))
                      (10 (- z y))
                      ((11 15) (+ y z))))
                 (s (- 0.5f0 (* x x) (* y y) (* z z))))
             (if (plusp s)
                 (* s s s s g)
                 0d0)))
         (get-simplex (x y z)
           (if (>= x y)
               (cond
                 ((>= y z) (values 1 0 0 1 1 0))
                 ((>= x z) (values 1 0 0 1 0 1))
                 (t (values 0 0 1 1 0 1)))
               (cond
                 ((< y z) (values 0 0 1 0 1 1))
                 ((< x z) (values 0 1 0 0 1 1))
                 (t (values 0 1 0 1 1 0))))))
    (declare (inline grad get-simplex))
    (let* ((table (simplex-3d-table sampler))
           (i-sum (+ xi yi zi))
           (f-sum (+ xf yf zf)))
      (declare (type fixnum i-sum))
      (when (>= f-sum 1f0)
        (incf i-sum)
        (decf f-sum))
      (multiple-value-bind (i-sum f-sum) (floor (* (+ i-sum (f64 f-sum)) +simplex-3d/skew+))
        (declare (type fixnum i-sum))
        (let* ((xf2 (+ xf f-sum))
               (yf2 (+ yf f-sum))
               (zf2 (+ zf f-sum))
               (x-carry (if (>= xf2 1f0) 1 0))
               (y-carry (if (>= yf2 1f0) 1 0))
               (z-carry (if (>= zf2 1f0) 1 0)))
          (when (plusp x-carry)
            (decf xf2))
          (when (plusp y-carry)
            (decf yf2))
          (when (plusp z-carry)
            (decf yf2))
          (let* ((x1 (+ xi i-sum x-carry))
                 (y1 (+ yi i-sum y-carry))
                 (z1 (+ zi i-sum z-carry))
                 (x2 (logand x1 255))
                 (y2 (logand y1 255))
                 (z2 (logand z1 255))
                 (u (* (the fixnum (+ x1 y1 z1)) +simplex-3d/unskew+))
                 (x3 (+ (- xi x1) xf u))
                 (y3 (+ (- yi y1) yf u))
                 (z3 (+ (- zi z1) zf u)))
            (declare (type fixnum x1 y1 z1))
            (multiple-value-bind (x4 y4 z4 x5 y5 z5) (get-simplex x3 y3 z3)
              (let* ((i1 (+ (aref table (+ (aref table z2) y2)) x2))
                     (i2 (+ (aref table (+ (aref table (+ z2 z4)) y2 y4)) x2 x4))
                     (i3 (+ (aref table (+ (aref table (+ z2 z5)) y2 y5)) x2 x5))
                     (i4 (+ (aref table (+ (aref table (1+ z2)) (1+ y2))) (1+ x2)))
                     (h2x (+ (- x3 x4) +simplex-3d/unskew+))
                     (h2y (+ (- y3 y4) +simplex-3d/unskew+))
                     (h2z (+ (- z3 z4) +simplex-3d/unskew+))
                     (h3x (+ (- x3 x5) #.(* +simplex-3d/unskew+ 2)))
                     (h3y (+ (- y3 y5) #.(* +simplex-3d/unskew+ 2)))
                     (h3z (+ (- z3 z5) #.(* +simplex-3d/unskew+ 2)))
                     (h4x (+ (1- x3) #.(* +simplex-3d/unskew+ 3)))
                     (h4y (+ (1- y3) #.(* +simplex-3d/unskew+ 3)))
                     (h4z (+ (1- z3) #.(* +simplex-3d/unskew+ 3)))
                     (p1 (grad (aref table i1) x3 y3 z3))
                     (p2 (grad (aref table i2) h2x h2y h2z))
                     (p3 (grad (aref table i3) h3x h3y h3z))
                     (p4 (grad (aref table i4) h4x h4y h4z)))
                (f32 (* (+ p1 p2 p3 p4) +simplex-3d/normalize+))))))))))

(defmethod sample-function ((sampler simplex-3d))
  #'sample-simplex-3d)
