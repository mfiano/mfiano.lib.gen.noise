(in-package #:mfiano.lib.gen.noise)

(defstruct (perlin-2d
            (:include sampler-2d)
            (:constructor %make-perlin-2d)
            (:predicate nil)
            (:copier nil))
  (table (make-u8-array 512) :type (u8-array 512)))

(defmethod (setf seed) :after (value (sampler perlin-2d))
  (setf (perlin-2d-table sampler) (make-lookup-table/perlin sampler)))

(defun make-perlin-2d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-perlin-2d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-perlin-2d (perlin-2d fixnum f32 fixnum f32) f32)
(declaim (inline sample-perlin-2d))
(defun sample-perlin-2d (sampler xi xf yi yf)
  (declare (optimize (speed 3)))
  (flet ((grad (hash x y)
           (case (logand hash 7)
             ((0 4) (- (+ x y)))
             ((1 6) (- x y))
             ((2 5) (- y x))
             ((3 7) (+ x y)))))
    (declare (inline grad))
    (let* ((table (perlin-2d-table sampler))
           (x1 (logand xi 255))
           (y1 (logand yi 255))
           (x2 (1- xf))
           (y2 (1- yf))
           (fx (curve5 xf))
           (fy (curve5 yf))
           (a (+ (aref table x1) y1))
           (b (+ (aref table (1+ x1)) y1))
           (c1 (aref table a))
           (c2 (aref table (1+ a)))
           (c3 (aref table b))
           (c4 (aref table (1+ b)))
           (p1 (s32:lerp (grad (aref table c1) xf yf) (grad (aref table c3) x2 yf) fx))
           (p2 (s32:lerp (grad (aref table c2) xf y2) (grad (aref table c4) x2 y2) fx)))
      (s32:lerp p1 p2 fy))))

(defmethod sample-function ((sampler perlin-2d))
  #'sample-perlin-2d)
