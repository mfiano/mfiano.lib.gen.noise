(in-package #:mfiano.lib.gen.noise)

(define-constant +value-cubic-2d/normalize+ 2.25f0 :test #'=)

(defstruct (value-cubic-2d
            (:include sampler-2d)
            (:constructor %make-value-cubic-2d)
            (:predicate nil)
            (:copier nil)))

(defun make-value-cubic-2d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-value-cubic-2d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-value-cubic-2d (value-cubic-2d fixnum f32 fixnum f32) f32)
(declaim (inline sample-value-cubic-2d))
(defun sample-value-cubic-2d (sampler xi xf yi yf)
  (declare (optimize (speed 3)))
  (flet ((hash (seed alpha c1x c1y c2x c2y c3x c3y c4x c4y)
           (let ((h1 (value-hash-2d seed c1x c1y))
                 (h2 (value-hash-2d seed c2x c2y))
                 (h3 (value-hash-2d seed c3x c3y))
                 (h4 (value-hash-2d seed c4x c4y)))
             (cubic-interpolate h1 h2 h3 h4 alpha))))
    (declare (inline hash))
    (let* ((seed (%seed sampler))
           (x1 (u64* xi +prime-x+))
           (y1 (u64* yi +prime-y+))
           (x2 (u64- x1 +prime-x+))
           (y2 (u64- y1 +prime-y+))
           (x3 (u64+ x1 +prime-x+))
           (y3 (u64+ y1 +prime-y+))
           (x4 (u64+ x1 #.(* +prime-x+ 2)))
           (y4 (u64+ y1 #.(* +prime-y+ 2)))
           (c1 (hash seed xf x2 y2 x1 y2 x3 y2 x4 y2))
           (c2 (hash seed xf x2 y1 x1 y1 x3 y1 x4 y1))
           (c3 (hash seed xf x2 y3 x1 y3 x3 y3 x4 y3))
           (c4 (hash seed xf x2 y4 x1 y4 x3 y4 x4 y4)))
      (/ (1- (cubic-interpolate c1 c2 c3 c4 yf)) +value-cubic-2d/normalize+))))

(defmethod sample-function ((sampler value-cubic-2d))
  #'sample-value-cubic-2d)
