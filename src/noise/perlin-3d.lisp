(in-package #:mfiano.lib.gen.noise)

(define-constant +perlin-3d/normalize+ 0.9658340808563753d0 :test #'=)

(defstruct (perlin-3d
            (:include sampler-3d)
            (:constructor %make-perlin-3d)
            (:predicate nil)
            (:copier nil))
  (table (make-u8-array 512) :type (u8-array 512)))

(defmethod (setf seed) :after (value (sampler perlin-3d))
  (setf (perlin-3d-table sampler) (make-lookup-table/perlin sampler)))

(defun make-perlin-3d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-perlin-3d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-perlin-3d (perlin-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-perlin-3d))
(defun sample-perlin-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (flet ((grad (hash x y z)
           (case (logand hash 15)
             ((0 12) (- (+ x y)))
             ((1 14) (- x y))
             (2 (- y x))
             (3 (+ x y))
             (4 (- (+ x z)))
             (5 (- x z))
             (6 (- z x))
             (7 (+ x z))
             (8 (- (+ y z)))
             ((9 13) (- y z))
             (10 (- z y))
             ((11 15) (+ y z)))))
    (declare (inline grad))
    (let* ((table (perlin-3d-table sampler))
           (x1 (logand xi 255))
           (y1 (logand yi 255))
           (z1 (logand zi 255))
           (x3 (1- xf) )
           (y3 (1- yf))
           (z3 (1- zf))
           (fx (curve5 xf))
           (fy (curve5 yf))
           (fz (curve5 zf))
           (a (+ (aref table x1) y1))
           (b (+ (aref table (1+ x1)) y1))
           (c1 (+ (aref table a) z1))
           (c2 (+ (aref table (1+ a)) z1))
           (c3 (+ (aref table b) z1))
           (c4 (+ (aref table (1+ b)) z1))
           (p1 (s32:lerp (grad (aref table c1) xf yf zf) (grad (aref table c3) x3 yf zf) fx))
           (p2 (s32:lerp (grad (aref table c2) xf y3 zf) (grad (aref table c4) x3 y3 zf) fx))
           (p3 (s32:lerp (grad (aref table (1+ c1)) xf yf z3)
                         (grad (aref table (1+ c3)) x3 yf z3)
                         fx))
           (p4 (s32:lerp (grad (aref table (1+ c2)) xf y3 z3)
                         (grad (aref table (1+ c4)) x3 y3 z3)
                         fx)))
      (f32 (* (s32:lerp (s32:lerp p1 p2 fy) (s32:lerp p3 p4 fy) fz) +perlin-3d/normalize+)))))

(defmethod sample-function ((sampler perlin-3d))
  #'sample-perlin-3d)
