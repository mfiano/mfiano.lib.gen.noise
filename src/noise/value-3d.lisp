(in-package #:mfiano.lib.gen.noise)

(defstruct (value-3d
            (:include sampler-3d)
            (:constructor %make-value-3d)
            (:predicate nil)
            (:copier nil)))

(defun make-value-3d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-value-3d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-value-3d (value-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-value-3d))
(defun sample-value-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (let* ((seed (%seed sampler))
         (x1 (u64* xi +prime-x+))
         (y1 (u64* yi +prime-y+))
         (z1 (u64* zi +prime-z+))
         (x2 (u64+ x1 +prime-x+))
         (y2 (u64+ y1 +prime-y+))
         (z2 (u64+ z1 +prime-z+))
         (x3 (curve3 xf))
         (y3 (curve3 yf))
         (z3 (curve3 zf))
         (h1 (value-hash-3d seed x1 y1 z1))
         (h2 (value-hash-3d seed x2 y1 z1))
         (h3 (value-hash-3d seed x1 y2 z1))
         (h4 (value-hash-3d seed x2 y2 z1))
         (h5 (value-hash-3d seed x1 y1 z2))
         (h6 (value-hash-3d seed x2 y1 z2))
         (h7 (value-hash-3d seed x1 y2 z2))
         (h8 (value-hash-3d seed x2 y2 z2))
         (p1 (s32:lerp h1 h2 x3))
         (p2 (s32:lerp h3 h4 x3))
         (p3 (s32:lerp h5 h6 x3))
         (p4 (s32:lerp h7 h8 x3)))
    (1- (s32:lerp (s32:lerp p1 p2 y3) (s32:lerp p3 p4 y3) z3))))

(defmethod sample-function ((sampler value-3d))
  #'sample-value-3d)
