(in-package #:mfiano.lib.gen.noise)

(define-constant +opensimplex2s-3d/normalize+ 1.9139959824512889d0 :test #'=)

(defstruct (opensimplex2s-3d
            (:include sampler-3d)
            (:constructor %make-opensimplex2s-3d)
            (:predicate nil)
            (:copier nil))
  (table (make-f64-array 1024) :type (f64-array 1024))
  (orientation nil :type opensimplex2-3d/orientation))

(defmethod (setf seed) :after (value (sampler opensimplex2s-3d))
  (setf (opensimplex2s-3d-table sampler) (make-lookup-table/opensimplex2 sampler)))

(defun make-opensimplex2s-3d (&key (seed 0) orient)
  (check-type seed u64)
  (check-type orient opensimplex2-3d/orientation)
  (let ((sampler (%make-opensimplex2s-3d :orientation orient)))
    (setf (seed sampler) seed)
    sampler))

(defmethod opensimplex2/gradient-scale ((sampler opensimplex2s-3d))
  0.2781926117527186d0)

(define-ftype sample-opensimplex2s-3d (opensimplex2s-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-opensimplex2s-3d))
(defun sample-opensimplex2s-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (labels ((c1 (table seed a x1 y1 z1 x2 y2 z2)
             (* a a a a (opensimplex2-3d/grad table seed x1 y1 z1 x2 y2 z2)))
           (c2 (table seed a x1 y1 z1 x2 y2 z2)
             (if (plusp a)
                 (c1 table seed a x1 y1 z1 x2 y2 z2)
                 0d0)))
    (declare (inline c1 c2))
    (let* ((table (opensimplex2s-3d-table sampler))
           (seed (%seed sampler))
           (seed2 (logxor seed #.(- +opensimplex2-3d/seed-flip+)))
           (orientation (opensimplex2s-3d-orientation sampler))
           (x (+ xi (f64 xf)))
           (y (+ yi (f64 yf)))
           (z (+ zi (f64 zf))))
      (multiple-value-bind (trx try trz) (opensimplex2-3d/orient orientation x y z)
        (declare (type (f64 #.(- #1=(expt 2d0 62)) #.#1#) trx try trz))
        (let* ((x1 (floor trx))
               (y1 (floor try))
               (z1 (floor trz))
               (vrx (- trx x1))
               (vry (- try y1))
               (vrz (- trz z1))
               (vpx (u64* x1 +prime-x+))
               (vpy (u64* y1 +prime-y+))
               (vpz (u64* z1 +prime-z+))
               (m1x (truncate (- -0.5d0 vrx)))
               (m1y (truncate (- -0.5d0 vry)))
               (m1z (truncate (- -0.5d0 vrz)))
               (m2x (logior m1x 1))
               (m2y (logior m1y 1))
               (m2z (logior m1z 1))
               (x2 (u64+ vpx (logand m1x +prime-x+)))
               (y2 (u64+ vpy (logand m1y +prime-y+)))
               (z2 (u64+ vpz (logand m1z +prime-z+)))
               (x3 (u64+ vpx +prime-x+))
               (y3 (u64+ vpy +prime-y+))
               (z3 (u64+ vpz +prime-z+))
               (x4 (u64+ vpx (logand (lognot m1x) +prime-x+)))
               (y4 (u64+ vpy (logand (lognot m1y) +prime-y+)))
               (z4 (u64+ vpz (logand (lognot m1z) +prime-z+)))
               (x5 (u64+ vpx (logand m1x #.(shl +prime-x+ 1))))
               (y5 (u64+ vpy (logand m1y #.(shl +prime-y+ 1))))
               (z5 (u64+ vpz (logand m1z #.(shl +prime-z+ 1))))
               (x6 (u64+ vpx (logand m1x #.(* +prime-x+ 2))))
               (x7 (+ vrx m1x))
               (y7 (+ vry m1y))
               (z7 (+ vrz m1z))
               (x8 (- vrx 0.5d0))
               (y8 (- vry 0.5d0))
               (z8 (- vrz 0.5d0))
               (x9 (- x7 m2x))
               (y9 (- y7 m2y))
               (z9 (- z7 m2z))
               (x10 (+ x8 m2x))
               (y10 (+ y8 m2y))
               (z10 (+ z8 m2z))
               (a1 (- #.(/ 2d0 3d0) (* x7 x7) (* y7 y7) (* z7 z7)))
               (a2 (- #.(/ 2d0 3d0) (* x8 x8) (* y8 y8) (* z8 z8)))
               (xf1 (* x8 (shl m2x 1)))
               (yf1 (* y8 (shl m2y 1)))
               (zf1 (* z8 (shl m2z 1)))
               (xf2 (1- (* x8 (- -2 (shl m1x 2)))))
               (yf2 (1- (* y8 (- -2 (shl m1y 2)))))
               (zf2 (1- (* z8 (- -2 (shl m1z 2)))))
               (xf3 (+ xf1 a1))
               (yf3 (+ yf1 a1))
               (zf3 (+ zf1 a1))
               (xf4 (+ xf2 a2))
               (yf4 (+ yf2 a2))
               (zf4 (+ zf2 a2))
               (r 0d0)
               (skip1 nil)
               (skip2 nil)
               (skip3 nil))
          (declare (type (integer -1 1) m1x m1y m1z))
          (incf r (c1 table seed a1 x2 y2 z2 x7 y7 z7))
          (incf r (c1 table seed2 a2 x3 y3 z3 x8 y8 z8))
          (cond
            ((plusp xf3)
             (incf r (c1 table seed xf3 x4 y2 z2 x9 y7 z7)))
            (t
             (incf r (c2 table seed (+ yf1 zf1 a1) x2 y4 z4 x7 y9 z9))
             (when (plusp xf4)
               (incf r (c1 table seed2 xf4 x6 y3 z3 x10 y8 z8))
               (setf skip1 t))))
          (cond
            ((plusp yf3)
             (incf r (c1 table seed yf3 x2 y4 z2 x7 y9 z7)))
            (t
             (incf r (c2 table seed (+ xf1 zf1 a1) x4 y2 z4 x9 y7 z9))
             (when (plusp yf4)
               (incf r (c1 table seed2 yf4 x3 y5 z3 x8 y10 z8))
               (setf skip2 t))))
          (cond
            ((plusp zf3)
             (incf r (c1 table seed zf3 x2 y2 z4 x7 y7 z9)))
            (t
             (incf r (c2 table seed (+ xf1 yf1 a1) x4 y4 z2 x9 y9 z7))
             (when (plusp zf4)
               (incf r (c1 table seed2 zf4 x3 y3 z5 x8 y8 z10))
               (setf skip3 t))))
          (unless skip1
            (incf r (c2 table seed2 (+ yf2 zf2 a2) x3 y5 z5 x8 y10 z10)))
          (unless skip2
            (incf r (c2 table seed2 (+ xf2 zf2 a2) x6 y3 z5 x10 y8 z10)))
          (unless skip3
            (incf r (c2 table seed2 (+ xf2 yf2 a2) x5 y5 z3 x10 y10 z8)))
          (f32 (* r +opensimplex2s-3d/normalize+)))))))

(defmethod sample-function ((sampler opensimplex2s-3d))
  #'sample-opensimplex2s-3d)
