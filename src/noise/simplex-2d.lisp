(in-package #:mfiano.lib.gen.noise)

(define-constant +simplex-2d/skew+ #.(/ (1- (sqrt 3d0)) 2) :test #'=)
(define-constant +simplex-2d/unskew+ #.(/ (- 3 (sqrt 3d0)) 6) :test #'=)
(define-constant +simplex-2d/normalize+ 45.23068537089276d0 :test #'=)

(defstruct (simplex-2d
            (:include sampler-2d)
            (:constructor %make-simplex-2d)
            (:predicate nil)
            (:copier nil))
  (table (make-u8-array 512) :type (u8-array 512)))

(defmethod (setf seed) :after (value (sampler simplex-2d))
  (setf (simplex-2d-table sampler) (make-lookup-table/perlin sampler)))

(defun make-simplex-2d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-simplex-2d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-simplex-2d (simplex-2d fixnum f32 fixnum f32) f32)
(declaim (inline sample-simplex-2d))
(defun sample-simplex-2d (sampler xi xf yi yf)
  (declare (optimize (speed 3)))
  (flet ((grad (hash x y)
           (let ((g (case (logand hash 7)
                      ((0 4) (- (+ x (* y 2))))
                      (1 (- x (* y 2)))
                      (2 (- y x))
                      (5 (- (* y 2) x))
                      (6 (- x y))
                      ((3 7) (+ x y))))
                 (s (- 0.5f0 (* x x) (* y y))))
             (if (plusp s)
                 (* s s s s g)
                 0d0)))
         (get-simplex (x y)
           (if (> x y)
               (values 1 0)
               (values 0 1))))
    (declare (inline grad get-simplex))
    (let* ((table (simplex-2d-table sampler))
           (i-sum (+ xi yi))
           (f-sum (+ xf yf)))
      (when (>= f-sum 1f0)
        (incf i-sum)
        (decf f-sum))
      (multiple-value-bind (i-sum f-sum) (floor (* (+ i-sum (f64 f-sum)) +simplex-2d/skew+))
        (declare (type fixnum i-sum))
        (let* ((xf2 (+ xf f-sum))
               (yf2 (+ yf f-sum))
               (x-carry (if (>= xf2 1f0) 1 0))
               (y-carry (if (>= yf2 1f0) 1 0)))
          (when (plusp x-carry)
            (decf xf2))
          (when (plusp y-carry)
            (decf yf2))
          (let* ((x1 (+ xi i-sum x-carry))
                 (y1 (+ yi i-sum y-carry))
                 (x2 (logand x1 255))
                 (y2 (logand y1 255))
                 (u (* (+ x1 y1) +simplex-2d/unskew+))
                 (x3 (+ (- xi x1) xf u))
                 (y3 (+ (- yi y1) yf u)))
            (declare (type fixnum x1 y1))
            (multiple-value-bind (x4 y4) (get-simplex x3 y3)
              (let ((p1 (grad (aref table (+ (aref table x2) y2)) x3 y3))
                    (p2 (grad (aref table (+ (aref table (+ x2 x4)) y2 y4))
                              (+ (- x3 x4) +simplex-2d/unskew+)
                              (+ (- y3 y4) +simplex-2d/unskew+)))
                    (p3 (grad (aref table (+ (aref table (1+ x2)) (1+ y2)))
                              (+ (1- x3) #.(* +simplex-2d/unskew+ 2))
                              (+ (1- y3) #.(* +simplex-2d/unskew+ 2)))))
                (f32 (* (+ p1 p2 p3) +simplex-2d/normalize+))))))))))

(defmethod sample-function ((sampler simplex-2d))
  #'sample-simplex-2d)
