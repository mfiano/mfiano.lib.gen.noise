(in-package #:mfiano.lib.gen.noise)

(define-constant +value-cubic-3d/normalize+ 3.375f0 :test #'=)

(defstruct (value-cubic-3d
            (:constructor %make-value-cubic-3d)
            (:predicate nil)
            (:copier nil))
  (seed 0 :type u64))

(defmethod (setf seed) (value (sampler value-cubic-3d))
  (setf (value-cubic-3d-seed sampler) value)
  (values))

(defun make-value-cubic-3d (&key (seed 0))
  (check-type seed u64)
  (let ((sampler (%make-value-cubic-3d)))
    (setf (seed sampler) seed)
    sampler))

(define-ftype sample-value-cubic-3d (value-cubic-3d fixnum f32 fixnum f32 fixnum f32) f32)
(declaim (inline sample-value-cubic-3d))
(defun sample-value-cubic-3d (sampler xi xf yi yf zi zf)
  (declare (optimize (speed 3)))
  (flet ((hash (seed alpha c1x c1y c1z c2x c2y c2z c3x c3y c3z c4x c4y c4z)
           (let ((h1 (value-hash-3d seed c1x c1y c1z))
                 (h2 (value-hash-3d seed c2x c2y c2z))
                 (h3 (value-hash-3d seed c3x c3y c3z))
                 (h4 (value-hash-3d seed c4x c4y c4z)))
             (cubic-interpolate h1 h2 h3 h4 alpha))))
    (declare (inline hash))
    (let* ((seed (value-cubic-3d-seed sampler))
           (x1 (u64* xi +prime-x+))
           (y1 (u64* yi +prime-y+))
           (z1 (u64* zi +prime-z+))
           (x2 (u64- x1 +prime-x+))
           (y2 (u64- y1 +prime-y+))
           (z2 (u64- z1 +prime-z+))
           (x3 (u64+ x1 +prime-x+))
           (y3 (u64+ y1 +prime-y+))
           (z3 (u64+ z1 +prime-z+))
           (x4 (u64+ x1 #.(* +prime-x+ 2)))
           (y4 (u64+ y1 #.(* +prime-y+ 2)))
           (z4 (u64+ z1 #.(* +prime-z+ 2)))
           (c1 (hash seed xf x2 y2 z2 x1 y2 z2 x3 y2 z2 x4 y2 z2))
           (c2 (hash seed xf x2 y1 z2 x1 y1 z2 x3 y1 z2 x4 y1 z2))
           (c3 (hash seed xf x2 y3 z2 x1 y3 z2 x3 y3 z2 x4 y3 z2))
           (c4 (hash seed xf x2 y4 z2 x1 y4 z2 x3 y4 z2 x4 y4 z2))
           (c5 (hash seed xf x2 y2 z1 x1 y2 z1 x3 y2 z1 x4 y2 z1))
           (c6 (hash seed xf x2 y1 z1 x1 y1 z1 x3 y1 z1 x4 y1 z1))
           (c7 (hash seed xf x2 y3 z1 x1 y3 z1 x3 y3 z1 x4 y3 z1))
           (c8 (hash seed xf x2 y4 z1 x1 y4 z1 x3 y4 z1 x4 y4 z1))
           (c9 (hash seed xf x2 y2 z3 x1 y2 z3 x3 y2 z3 x4 y2 z3))
           (c10 (hash seed xf x2 y1 z3 x1 y1 z3 x3 y1 z3 x4 y1 z3))
           (c11 (hash seed xf x2 y3 z3 x1 y3 z3 x3 y3 z3 x4 y3 z3))
           (c12 (hash seed xf x2 y4 z3 x1 y4 z3 x3 y4 z3 x4 y4 z3))
           (c13 (hash seed xf x2 y2 z4 x1 y2 z4 x3 y2 z4 x4 y2 z4))
           (c14 (hash seed xf x2 y1 z4 x1 y1 z4 x3 y1 z4 x4 y1 z4))
           (c15 (hash seed xf x2 y3 z4 x1 y3 z4 x3 y3 z4 x4 y3 z4))
           (c16 (hash seed xf x2 y4 z4 x1 y4 z4 x3 y4 z4 x4 y4 z4))
           (r1 (cubic-interpolate c1 c2 c3 c4 yf))
           (r2 (cubic-interpolate c5 c6 c7 c8 yf))
           (r3 (cubic-interpolate c9 c10 c11 c12 yf))
           (r4 (cubic-interpolate c13 c14 c15 c16 yf)))
      (/ (1- (cubic-interpolate r1 r2 r3 r4 zf)) +value-cubic-3d/normalize+))))

(defmethod sample-function ((sampler value-cubic-3d))
  #'sample-value-cubic-3d)
