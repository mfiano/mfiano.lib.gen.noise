(in-package #:mfiano.lib.gen.noise)

(defun make-axis (min max size)
  (let* ((integers (make-fixnum-array size))
         (fractions (make-f32-array size))
         (min (rational min))
         (step (/ (- (rational max) min) size)))
    (dotimes (index size)
      (multiple-value-bind (integer fraction) (floor (+ min (* index step)))
        (setf (aref integers index) integer
              (aref fractions index) (f32 fraction))))
    (values integers fractions)))

(defmacro define-field-maker (name &rest z)
  `(defun ,name (sampler xi xf yi yf)
     (let ((func (sample-function sampler)))
       (declare (type (fixnum-array (*)) xi yi)
                (type (f32-array (*)) xf yf)
                (type (function (t fixnum f32 fixnum f32 ,@(when z '(fixnum f32))) f32) func))
       (lambda (buffer index x y count)
         (declare (optimize (speed 3))
                  (type pb:buffer buffer)
                  (type pb:index index)
                  (type u16 x y count))
         (let ((row-i (aref yi y))
               (row-f (aref yf y)))
           (flet ((sample (column)
                    (funcall func sampler (aref xi column) (aref xf column) row-i row-f ,@z)))
             (declare (inline sample))
             (loop :with end :of-type fixnum := (+ index (* count 4))
                   :for lane :of-type fixnum :from index :below end :by 4
                   :for column :of-type fixnum :from x
                   :do (let ((value (* (1+ (sample column)) 0.5d0)))
                         (pb:set-channels buffer lane value value value 1d0)))))
         (values)))))

(define-field-maker make-field/2d)

(define-field-maker make-field/3d 0 0.5f0)

(defun make-field (sampler &key width height (x-min -1) (x-max 1) (y-min -1) (y-max 1))
  (assert-sampler sampler)
  (check-type width u16+)
  (check-type height u16+)
  (check-type x-min real)
  (check-type x-max real)
  (check-type y-min real)
  (check-type y-max real)
  (assert (< x-min x-max))
  (assert (< y-min y-max))
  (multiple-value-bind (xi xf) (make-axis x-min x-max width)
    (multiple-value-bind (yi yf) (make-axis y-min y-max height)
      (ecase (dimensions sampler)
        (2 (make-field/2d sampler xi xf yi yf))
        (3 (make-field/3d sampler xi xf yi yf))))))
