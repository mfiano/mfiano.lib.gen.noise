(in-package #:mfiano.lib.gen.noise)

(deftype image () '(or (u8-array (*)) (u32-array (*))))

(defstruct (field
            (:constructor %make-field)
            (:predicate nil)
            (:copier nil))
  (width 0 :type u16)
  (height 0 :type u16)
  (xi 0 :type i32)
  (xf 0f0 :type f32)
  (x-step-i 0 :type i32)
  (x-step-f 0f0 :type f32)
  (yi 0 :type i32)
  (yf 0f0 :type f32)
  (y-step-i 0 :type i32)
  (y-step-f 0f0 :type f32)
  (threads 1 :type u8+)
  (kernel (lp:make-kernel 1) :type lp:kernel)
  (workspace (make-f64-array 0) :type pb:buffer)
  (encoder (constantly nil) :type function))

(defgeneric sample-field (field sampler pixels))

(defun make-field (&key
                     (pixel-format 'pf:rgba8888/u32)
                     (threads 4)
                     width
                     height
                     (x-min -1f0)
                     (x-max 1f0)
                     (y-min -1f0)
                     (y-max 1f0))
  (check-type pixel-format pf:pixel-format)
  (check-type threads u8+)
  (check-type width u16+)
  (check-type height u16+)
  (check-type x-min real)
  (check-type x-max real)
  (check-type y-min real)
  (check-type y-max real)
  (assert (< x-min x-max))
  (assert (< x-min x-max))
  (let* ((kernel (lp:make-kernel threads :name "Noise field"))
         (row-length (* width 4))
         (workspace (make-f64-array (* row-length threads)))
         (encoder (pf:encoder pixel-format))
         (x-step (/ (- x-max x-min) width))
         (y-step (/ (- y-max y-min) height)))
    (check-type encoder function)
    (multiple-value-bind (xi xf) (floor x-min)
      (multiple-value-bind (x-step-i x-step-f) (floor x-step)
        (multiple-value-bind (yi yf) (floor y-min)
          (multiple-value-bind (y-step-i y-step-f) (floor y-step)
            (%make-field :width width
                         :height height
                         :xi xi
                         :xf (f32 xf)
                         :x-step-i x-step-i
                         :x-step-f (f32 x-step-f)
                         :yi yi
                         :yf (f32 yf)
                         :y-step-i y-step-i
                         :y-step-f (f32 y-step-f)
                         :threads threads
                         :kernel kernel
                         :workspace workspace
                         :encoder encoder)))))))

(defmacro do-field-sample (dimensions)
  (let ((types (list t 'fixnum 'f32 'fixnum 'f32))
        (args (list 'sampler 'xi 'xf 'yi 'yf)))
    (case dimensions
      (3
       (appendf types (list 'fixnum 'f32))
       (appendf args (list 0 0.5f0))))
    `(lp:pdotimes (row-offset height)
       (declare (type u16 row-offset))
       (let* ((workspace (field-workspace field))
              (workspace-lanes 4)
              (workspace-row-width (* width workspace-lanes))
              (xi (field-xi field))
              (xf (field-xf field))
              (x-step-i (field-x-step-i field))
              (x-step-f (field-x-step-f field))
              (yi (field-yi field))
              (yf (field-yf field))
              (y-step-i (field-y-step-i field))
              (y-step-f (field-y-step-f field))
              (pixel-index (* row-offset width))
              (worker (or (lp:kernel-worker-index) 0))
              (workspace-index (* worker workspace-row-width)))
         (declare (type pb:index workspace-index))
         (declare (type (function ,types f32) func))
         (multiple-value-bind (y-carry yf) (floor (+ yf (* row-offset y-step-f)))
           (let ((yi (+ yi (* row-offset y-step-i) y-carry)))
             (declare (type fixnum yi))
             (let ((lane-index workspace-index))
               (dotimes (column-offset width)
                 (let ((sample (* (1+ (funcall func ,@args)) 0.5d0)))
                   (pb:set-channels workspace lane-index sample sample sample 1d0)
                   (incf lane-index workspace-lanes)
                   (incf xi x-step-i)
                   (incf xf x-step-f)
                   (when (>= xf 1f0)
                     (incf xi)
                     (decf xf)))))))
         (funcall encoder workspace workspace-index pixels pixel-index width)))))

(defmethod sample-field ((field field) (sampler sampler-2d) (pixels simple-array))
  (declare (optimize (speed 3)))
  (assert-sampler-dimensions sampler 2)
  (let ((width (field-width field))
        (height (field-height field))
        (encoder (field-encoder field))
        (func (sample-function sampler))
        (lp:*kernel* (field-kernel field)))
    (do-field-sample 2)
    (values)))

(defmethod sample-field ((field field) (sampler sampler-3d) (pixels simple-array))
  (declare (optimize (speed 3)))
  (assert-sampler-dimensions sampler 3)
  (let ((width (field-width field))
        (height (field-height field))
        (encoder (field-encoder field))
        (func (sample-function sampler))
        (lp:*kernel* (field-kernel field)))
    (do-field-sample 3)
    (values)))
